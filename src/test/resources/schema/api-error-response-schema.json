{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "status", "error", "message", "path"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp indicating when the error occurred."
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599,
      "description": "HTTP error status code (4xx or 5xx)."
    },
    "error": {
      "type": "string",
      "description": "HTTP error reason phrase."
    },
    "message": {
      "type": "string",
      "description": "Summary of the error."
    },
    "path": {
      "type": "string",
      "description": "The request path that resulted in the error."
    },
    "details": {
      "type": "object",
      "description": "Optional field-level validation or domain errors.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}